<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.zzu.mapper.MovieMapper">

    <resultMap id="BaseResultMap" type="movie">
            <id property="mid" column="mid" jdbcType="INTEGER"/>
            <result property="mname" column="mname" jdbcType="VARCHAR"/>
            <result property="director" column="director" jdbcType="VARCHAR"/>
            <result property="releaseDate" column="release_date" jdbcType="DATE"/>
            <result property="synopsis" column="synopsis" jdbcType="VARCHAR"/>
            <result property="poster" column="poster" jdbcType="VARCHAR"/>
            <result property="type" column="type" jdbcType="VARCHAR"/>
            <result property="runtime" column="runtime" jdbcType="INTEGER"/>
            <result property="version" column="version" jdbcType="INTEGER"/>
            <result property="isDeleted" column="is_deleted" jdbcType="INTEGER"/>
    </resultMap>

    <sql id="Base_Column_List">
        mid,mname,director,
        release_date,synopsis,poster,
        type,runtime,version,
        is_deleted
    </sql>

</mapper>
